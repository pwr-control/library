component half_bridge_ttype
% Half Bridge T-Type (ideal)
% One three-level T-type leg (half bridge): four ideal switches with
% antiparallel freewheeling diodes, no switching dynamics, no conduction
% drop (Vf = 0), no losses apart from the numerical Ron. Bidirectional:
% the same block works with the power flowing in either direction.
%
% T-type leg (same arrangement and numbering as the T-type blocks of
% masked_models/semiconductors_bridges and of afe_ttype_ssc):
%   Q1     between + and the midpoint m (collector on +):  m = +  when on
%   Q4     between m and - (collector on m):               m = -  when on
%   Q2, Q3 in anti-series, common emitter, between np and m (Q2 collector
%          on np, Q3 collector on m):                      m = np when both on
% Allowed states: P = {Q1, Q2}, O = {Q2, Q3}, N = {Q3, Q4}; Q1/Q3 and Q2/Q4
% are the complementary pairs. Because of the antiparallel diodes, Q1 with
% Q3 on shorts the upper bank through D2 (3*Ron), Q4 with Q2 on shorts the
% lower bank through D3 (3*Ron), Q1 with Q4 on shorts the whole DC link
% (2*Ron). No dead time and no interlock inside the block: both belong to
% the modulator.
%
% Each switch + diode pair (current i, voltage v, collector -> emitter):
%   gate on  (G(k) > Vth)   ->  i = v/Ron   (bidirectional)
%   gate off, v < 0         ->  i = v/Ron   (antiparallel diode conducting)
%   gate off, v >= 0        ->  i = v*Goff  (blocking)
%
% Optional integrated passives (parameters on/off), so that one converter
% is ONE Simulink block (relevant for the 1000 non-virtual block limit of
% the Home licence):
%   - split DC link: Cdc1 + Rdc1 from + to np and Cdc2 + Rdc2 from np to -,
%     both at Vdc0/2 at the start. The neutral point np is a port in any
%     case: leave it unconnected with cap_dc = on (the two banks define it),
%     connect it to the external split DC link (dclink_for_three_levels, or
%     another T-type block with its capacitors on) with cap_dc = off. The
%     series resistances keep the two bank voltages independent states when
%     an ideal DC source sits across + and - (set Vdc0 equal to its voltage).
%   - series inductor L + RL between the midpoint and the terminal a; the
%     inductor current i_a is a state.
%
% Gate input G: physical-signal vector [4x1] in V, order
%     G = [Q1; Q2; Q3; Q4]
% (gate_cmds.cmd_gate_Q1..Q4 of the library three-level modulators). Drive
% it with +15 V (on) / -10 V (off) and Vth = 2.5 V, or with 0/1 and
% Vth = 0.5 V. One Simulink-PS Converter with a 4-wide Simulink vector.
% Three-level modulation with the reference m in [-1, 1] and the carrier c
% in [0, 1]: m >= 0, Q2 on, Q4 off, Q1 on while c < m (duty m), Q3 = not Q1;
% m < 0, Q3 on, Q1 off, Q4 on while c < -m (duty -m), Q2 = not Q4. The
% midpoint then averages m*Vdc/2 with respect to np (balanced banks).
%
% Outputs (physical signals): I = i_a terminal current, positive OUT of
% the bridge (midpoint -> a); V = [vdc; vdc1; vdc2] = [(+) - (-);
% (+) - np; np - (-)], the DC-link voltage and the two bank voltages
% (vdc1 - vdc2 is the neutral-point unbalance). Leave them unconnected if
% not needed.
%
% Ports: + np - (DC, left), a (AC, right), G (bottom), I V (top).
% Initial conditions: Vdc0 (parameter, only with cap_dc = on); inductor
% current from the Variables tab of the block dialog.

  nodes
    p  = foundation.electrical.electrical; % +:left
    np = foundation.electrical.electrical; % np:left
    n  = foundation.electrical.electrical; % -:left
    a  = foundation.electrical.electrical; % a:right
  end

  inputs
    G = {zeros(4,1), 'V'}; % G:bottom
  end

  outputs
    I = {0, 'A'};          % I:top
    V = {zeros(3,1), 'V'}; % V:top
  end

  parameters
    % --- switches (numerical values, no losses) ---
    Vth    = {2.5,   'V'    };            % Gate threshold voltage
    Ron    = {1e-3,  'Ohm'  };            % On-state resistance (switch and diode)
    Goff   = {1e-6,  '1/Ohm'};            % Off-state conductance
    % --- split DC link ---
    cap_dc = ideal_bridges.onoff.on;      % Split DC-link capacitors
    Cdc1   = {4e-3,  'F'    };            % Upper bank capacitance, + to np
    Rdc1   = {1e-3,  'Ohm'  };            % Upper bank series resistance
    Cdc2   = {4e-3,  'F'    };            % Lower bank capacitance, np to -
    Rdc2   = {1e-3,  'Ohm'  };            % Lower bank series resistance
    Vdc0   = {0,     'V'    };            % DC-link initial voltage (Vdc0/2 per bank)
    % --- AC inductor ---
    ind_ac = ideal_bridges.onoff.on;      % AC series inductor
    L      = {1e-3,  'H'    };            % Inductance
    RL     = {10e-3, 'Ohm'  };            % Series resistance
  end

  variables
    vc1  = {0, 'V'};   % Upper bank capacitor voltage (without Rdc1)
    vc2  = {0, 'V'};   % Lower bank capacitor voltage (without Rdc2)
    ic1  = {0, 'A'};   % Upper bank current, (+) -> np
    ic2  = {0, 'A'};   % Lower bank current, np -> (-)
    vm_a = {0, 'V'};   % Midpoint voltage of the leg (bridge side of the inductor)
    vs_a = {0, 'V'};   % Common-emitter voltage of the neutral pair Q2/Q3
    i1_a = {0, 'A'};   % Current of Q1, (+) -> midpoint
    i2_a = {0, 'A'};   % Current of Q2, np -> common emitter
    i3_a = {0, 'A'};   % Current of Q3, midpoint -> common emitter
    i4_a = {0, 'A'};   % Current of Q4, midpoint -> (-)
    i_a  = {0, 'A'};   % Terminal current, midpoint -> a (inductor current)
  end

  intermediates (ExternalAccess = observe)
    v1_a = p.v - vm_a;   % Voltage across Q1 (collector - emitter)
    v2_a = np.v - vs_a;  % Voltage across Q2
    v3_a = vm_a - vs_a;  % Voltage across Q3
    v4_a = vm_a - n.v;   % Voltage across Q4
    vdc  = p.v - n.v;    % DC-link voltage, (+) - (-)
    vdc1 = p.v - np.v;   % Upper bank voltage at the terminals, (+) - np
    vdc2 = np.v - n.v;   % Lower bank voltage at the terminals, np - (-)
    i_np = i3_a;         % Neutral-point current, from the leg INTO np
  end

  branches
    % The midpoint and the common-emitter node of the neutral pair are
    % internal algebraic variables, not nodes: Q1 is declared as a branch
    % (+) -> a, Q4 as a -> (-) and the neutral pair as a -> np carrying the
    % current of Q3 (= -i2 by the KCL of the common-emitter node), so that
    % the current leaving terminal a is i1 - i4 - i3.
    ic1  : p.i  -> np.i;
    ic2  : np.i -> n.i;
    i1_a : p.i  -> a.i;
    i4_a : a.i  -> n.i;
    i3_a : a.i  -> np.i;
  end

  equations
    % ---------- split DC link ----------
    if cap_dc == ideal_bridges.onoff.on
      ic1 == Cdc1*vc1.der;
      ic2 == Cdc2*vc2.der;
      vdc1 == vc1 + Rdc1*ic1;
      vdc2 == vc2 + Rdc2*ic2;
    else
      ic1 == 0;
      ic2 == 0;
      vc1 == vdc1;
      vc2 == vdc2;
    end

    % ---------- switch + antiparallel diode pairs ----------
    if (G(1) > Vth) || (v1_a < 0)
      i1_a == v1_a/Ron;
    else
      i1_a == v1_a*Goff;
    end
    if (G(2) > Vth) || (v2_a < 0)
      i2_a == v2_a/Ron;
    else
      i2_a == v2_a*Goff;
    end
    if (G(3) > Vth) || (v3_a < 0)
      i3_a == v3_a/Ron;
    else
      i3_a == v3_a*Goff;
    end
    if (G(4) > Vth) || (v4_a < 0)
      i4_a == v4_a/Ron;
    else
      i4_a == v4_a*Goff;
    end
    % common-emitter node of the neutral pair, leg midpoint
    i2_a + i3_a == 0;
    i_a == i1_a - i4_a - i3_a;

    % ---------- AC terminal ----------
    if ind_ac == ideal_bridges.onoff.on
      vm_a - a.v == L*i_a.der + RL*i_a;
    else
      vm_a == a.v;
    end

    % ---------- measurements ----------
    I == i_a;
    V == [vdc; vdc1; vdc2];
  end

  % DC-link initial voltage: half of Vdc0 on each bank (only with the capacitors)
  if cap_dc == ideal_bridges.onoff.on
    equations (Initial = true)
      vc1 == Vdc0/2;
      vc2 == Vdc0/2;
    end
  end

  % hide the parameters of the passives that are switched off
  if cap_dc == ideal_bridges.onoff.off
    annotations
      [Cdc1, Rdc1, Cdc2, Rdc2, Vdc0] : ExternalAccess = none;
    end
  end
  if ind_ac == ideal_bridges.onoff.off
    annotations
      [L, RL] : ExternalAccess = none;
    end
  end

  annotations
    p  : Side = left;
    np : Side = left;
    n  : Side = left;
    a  : Side = right;
    G  : Side = bottom;
    I  : Side = top;
    V  : Side = top;
    UILayout = [UIGroup("Switches", Vth, Ron, Goff)
                UIGroup("Split DC link", cap_dc, Cdc1, Rdc1, Cdc2, Rdc2, Vdc0)
                UIGroup("AC inductor", ind_ac, L, RL)];
  end

end
