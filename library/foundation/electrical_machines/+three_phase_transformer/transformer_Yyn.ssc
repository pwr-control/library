component transformer_Yyn
% Three-Phase Transformer Yyn (star primary, star secondary, both neutrals exposed)
%
% Two-winding three-phase transformer on a three-limb core: one primary and
% one secondary coil on each limb (a, b, c). The primary coils are connected
% in star between the line terminals A, B, C and the neutral N; the
% secondary coils in star between a, b, c and the neutral n. Both neutrals
% are brought out: connect N to ground (or to the source neutral) for a
% YNyn transformer, leave it unconnected for the usual Yyn with isolated
% primary star point, connect n to the load neutral or to ground. The
% vector group is selected with clock_number:
%
%    0 (default)  Yyn0: u_an in phase with u_AN (same winding sense)
%    6            Yyn6: u_an opposite to u_AN (secondary coils reversed)
%
% Equations, for each limb k with flux linkage psi_k of its primary coil
% (N1 turns), n21 = N2/N1 the coil turns ratio and s = +1 (Yyn0) or -1
% (Yyn6) the sense of the secondary coil:
%
%   limb voltage (induced in the primary coil by the flux of its limb)
%       um_k = dpsi_k/dt
%   primary coil (star, terminal X to N, current i1k into X)
%       u_XN = R1 i1k + L1 di1k/dt + um_k
%   secondary coil (star, terminal x to n, current i2k out of x)
%       u_xn = s n21 um_k - R2 i2k - L2 di2k/dt
%   mmf balance of the limb, in primary turns
%       im_k = i1k - s n21 i2k - ife_k,   ife_k = um_k/Rfe
%   magnetic circuit of the three-limb core
%       psi_k = Lm im_k - Lc (im_a + im_b + im_c),   Lc = (Lm - Lm0)/3
%
% i.e. the magnetizing inductance is Lm for the positive and the negative
% sequence of the magnetizing currents and Lm0 for the zero sequence (sum
% of the three limb fluxes, which in a three-limb core returns through air,
% tank and clearances: lm0 of a fraction of a pu). lm0 = lm reproduces a
% bank of three single-phase units or a five-limb core. Core losses are a
% linear resistance Rfe per limb on the primary coil voltage.
%
% Zero sequence and neutral shift. A star-star transformer has no delta to
% carry the zero-sequence current: with a single-phase load between a and
% n the load current returns through n and must be balanced on the limb by
% the primary. If N is unconnected the primary line currents sum to zero,
% the zero-sequence part of the load current (one third of it) is not
% balanced and becomes zero-sequence magnetizing current: the three limb
% fluxes shift by the same amount, the secondary star point moves with
% respect to the line voltages (neutral displacement) and the primary
% star point as well. The zero-sequence impedance seen from the secondary
% is then r2 + j(l2 + lm0) pu: small for a three-limb core (lm0 of a
% fraction of a pu, i.e. a shift of a few percent at rated single-phase
% current), huge for a bank of single-phase units (lm0 = lm, the loaded
% phase voltage collapses). With N connected to the source neutral the
% zero-sequence current flows in the primary too and the zero-sequence
% impedance drops to about (r1 + r2) + j(l1 + l2) in parallel with j lm0.
% Compare with transformer_Dyn, whose delta carries the zero sequence.
%
% Per-unit parameters on the rated three-phase power Sr and the rated
% line-to-line voltages V1, V2: every coil is a star coil, so its base
% impedance is the star equivalent V1^2/Sr (V2^2/Sr) and the coil turns
% ratio is n21 = V2/V1. From the nameplate: l1 + l2 = ucc/100
% (short-circuit voltage), r1 + r2 = copper losses / Sr, lm = rated
% current / magnetizing current, rfe = Sr / iron losses.
%
% Positive current is taken into A, B, C and out of a, b, c (towards the
% load); i1a + i1b + i1c flows out of N and i2a + i2b + i2c returns through
% n. The outputs psi_a, psi_b, psi_c are the flux linkages of the primary
% coils (V*s). Linear magnetics: no saturation, no hysteresis, no winding
% capacitances, no thermal port.

nodes
    A = foundation.electrical.electrical; % A:left
    B = foundation.electrical.electrical; % B:left
    C = foundation.electrical.electrical; % C:left
    N = foundation.electrical.electrical; % N:left
    a = foundation.electrical.electrical; % a:right
    b = foundation.electrical.electrical; % b:right
    c = foundation.electrical.electrical; % c:right
    n = foundation.electrical.electrical; % n:right
end

outputs
    psi_a = {0, 'V*s'};  % psi_a:right
    psi_b = {0, 'V*s'};  % psi_b:right
    psi_c = {0, 'V*s'};  % psi_c:right
end

parameters
    Sr  = {1e6,   'V*A'};   % Rated apparent power (three-phase)
    V1  = {690,   'V'  };   % Primary rated line-to-line voltage (rms)
    V2  = {690,   'V'  };   % Secondary rated line-to-line voltage (rms)
    fr  = {50,    'Hz' };   % Rated frequency
    clock_number = {0, '1'};    % Vector group clock number (0 or 6)
    r1  = {0.005, '1'  };   % Primary winding resistance (pu)
    l1  = {0.025, '1'  };   % Primary leakage inductance (pu)
    r2  = {0.005, '1'  };   % Secondary winding resistance (pu)
    l2  = {0.025, '1'  };   % Secondary leakage inductance (pu)
    lm  = {100,   '1'  };   % Positive-sequence magnetizing inductance (pu)
    lm0 = {0.5,   '1'  };   % Zero-sequence magnetizing inductance (pu)
    rfe = {500,   '1'  };   % Core-loss resistance per limb (pu)
end

parameters(Access=private)
    wb  = {2*pi,'rad'}*fr;    % rated angular frequency
    Zb1 = V1^2/Sr;            % base impedance of a primary coil (star)
    Zb2 = V2^2/Sr;            % base impedance of a secondary coil (star)
    n21 = V2/V1;              % coil turns ratio N2/N1
    s2  = 1 - clock_number/3; % sense of the secondary coils: +1 for Yyn0, -1 for Yyn6
    R1  = r1*Zb1;             % resistance of one primary coil
    L1  = l1*Zb1/wb;          % leakage inductance of one primary coil
    R2  = r2*Zb2;             % resistance of one secondary coil
    L2  = l2*Zb2/wb;          % leakage inductance of one secondary coil
    Lm  = lm*Zb1/wb;          % positive-sequence magnetizing inductance, primary coil referred
    Lm0 = lm0*Zb1/wb;         % zero-sequence magnetizing inductance, primary coil referred
    Lc  = (Lm - Lm0)/3;       % limb-to-limb coupling term of the magnetizing inductance matrix
    Rfe = rfe*Zb1;            % core-loss resistance per limb, primary coil referred
end

variables
    i1a = {0, 'A'};  % primary current into A (coil of limb a, A -> N)
    i1b = {0, 'A'};  % primary current into B (coil of limb b, B -> N)
    i1c = {0, 'A'};  % primary current into C (coil of limb c, C -> N)
    i2a = {0, 'A'};  % secondary current out of a (returns through n)
    i2b = {0, 'A'};  % secondary current out of b
    i2c = {0, 'A'};  % secondary current out of c
end

variables(Access=private)
    psia = {0, 'V*s'};  % flux linkage of the primary coil of limb a
    psib = {0, 'V*s'};  % flux linkage of the primary coil of limb b
    psic = {0, 'V*s'};  % flux linkage of the primary coil of limb c
    uma  = {0, 'V'};    % limb voltage dpsi_a/dt, induced in the primary coil of limb a
    umb  = {0, 'V'};    % limb voltage of limb b
    umc  = {0, 'V'};    % limb voltage of limb c
    ima  = {0, 'A'};    % magnetizing current of limb a, primary coil referred
    imb  = {0, 'A'};    % magnetizing current of limb b
    imc  = {0, 'A'};    % magnetizing current of limb c
end

branches
    i1a : A.i -> N.i;
    i1b : B.i -> N.i;
    i1c : C.i -> N.i;
    i2a : n.i -> a.i;
    i2b : n.i -> b.i;
    i2c : n.i -> c.i;
end

equations
    assert(Sr  > 0, 'Rated power must be positive')
    assert(V1  > 0 && V2 > 0, 'Rated voltages must be positive')
    assert(fr  > 0, 'Rated frequency must be positive')
    assert(r1 >= 0 && r2 >= 0, 'Winding resistances must be non-negative')
    assert(l1 >= 0 && l2 >= 0, 'Leakage inductances must be non-negative')
    assert(lm  > 0 && lm0 > 0, 'Magnetizing inductances must be positive')
    assert(rfe > 0, 'Core-loss resistance must be positive')
    assert(clock_number == 0 || clock_number == 6, 'clock_number must be 0 or 6')

    % Limb voltages: the voltage induced in the primary coil of each limb by
    % its flux linkage. These are the only equations with der(psi): Simscape
    % counts every equation that contains der() as a differential equation
    % and requires as many of them as differentiated variables (9 here:
    % three fluxes, three primary and three secondary coil currents), so
    % the derivative of each flux is written once and the limb voltage is
    % used algebraically everywhere else.
    uma == der(psia);
    umb == der(psib);
    umc == der(psic);

    % Primary coils, star between the line terminals and N (motor
    % convention): resistive and leakage drop plus the limb voltage.
    A.v - N.v == R1*i1a + L1*der(i1a) + uma;
    B.v - N.v == R1*i1b + L1*der(i1b) + umb;
    C.v - N.v == R1*i1c + L1*der(i1c) + umc;

    % Secondary coils, star between the line terminals and n (generator
    % convention): the emf s2*n21*um of the coil on the same limb minus the
    % drop of the current delivered to the load.
    a.v - n.v == s2*n21*uma - R2*i2a - L2*der(i2a);
    b.v - n.v == s2*n21*umb - R2*i2b - L2*der(i2b);
    c.v - n.v == s2*n21*umc - R2*i2c - L2*der(i2c);

    % Magneto-motive force balance of each limb, referred to the primary
    % coil: the secondary current demagnetizes with s2*n21*i2 (its sense
    % follows the vector group) and the core-loss current um/Rfe is
    % subtracted from the net mmf.
    ima == i1a - s2*n21*i2a - uma/Rfe;
    imb == i1b - s2*n21*i2b - umb/Rfe;
    imc == i1c - s2*n21*i2c - umc/Rfe;

    % Magnetic circuit of the three-limb core: Lm for the positive and the
    % negative sequence of the magnetizing currents, Lm0 for the zero
    % sequence. With N unconnected the zero-sequence part of an unbalanced
    % secondary current can only be balanced here: the neutral shift.
    psia == Lm*ima - Lc*(ima + imb + imc);
    psib == Lm*imb - Lc*(ima + imb + imc);
    psic == Lm*imc - Lc*(ima + imb + imc);

    psi_a == psia;
    psi_b == psib;
    psi_c == psic;
end

annotations
    UILayout = [
        UIGroup('Ratings', Sr, V1, V2, fr)
        UIGroup('Vector group', clock_number)
        UIGroup('Impedances', r1, l1, r2, l2, lm, lm0, rfe)];
end

end
