component transformer_Dyn
% Three-Phase Transformer Dyn (delta primary, star secondary with neutral)
%
% Two-winding three-phase transformer on a three-limb core: one primary and
% one secondary coil on each limb (a, b, c). The primary coils are connected
% in delta between the line terminals A, B, C; the secondary coils in star
% between the line terminals a, b, c and the neutral n, which is brought out
% (connect it to ground or to the load neutral, or leave it unconnected for
% an isolated star). The vector group is selected with clock_number:
%
%   11 (default)  Dyn11: the secondary phase voltage u_an is in phase with
%                 the primary LINE voltage u_AB, i.e. it LEADS the primary
%                 phase voltage u_AN by 30 degrees (11 o'clock)
%    1            Dyn1:  u_an in phase with u_AC, LAGS u_AN by 30 degrees
%    5            Dyn5:  u_an in phase with u_BA, 150 degrees lagging
%    7            Dyn7:  u_an in phase with u_CA, 150 degrees leading
%
% The phase shift comes only from the connection: the secondary coil of
% phase a is wound on the limb whose primary coil is across A-B (Dyn11, same
% sense), across A-C (Dyn1, i.e. the C-A coil with reversed sense), or on
% the same limbs with reversed sense (Dyn5, Dyn7 from Dyn11, Dyn1).
%
% Equations, for each limb k with flux linkage psi_k of its primary coil
% (N1 turns) and n21 = N2/N1 the coil turns ratio:
%
%   limb voltage (induced in the primary coil by the flux of its limb)
%       um_k = dpsi_k/dt
%   primary coil (delta, terminals P -> Q, current i1k from P to Q)
%       u_PQ = R1 i1k + L1 di1k/dt + um_k
%   secondary coil (star, terminal x to n, current i2x out of x)
%       u_xn = s n21 um_k - R2 i2x - L2 di2x/dt        (s = +1 or -1)
%   mmf balance of the limb, in primary turns
%       im_k = i1k - s n21 i2x - ife_k,   ife_k = um_k/Rfe
%   magnetic circuit of the three-limb core
%       psi_k = Lm im_k - Lc (im_a + im_b + im_c),   Lc = (Lm - Lm0)/3
%
% i.e. the magnetizing inductance is Lm for the positive and the negative
% sequence of the magnetizing currents and Lm0 for the zero sequence (sum
% of the three limb fluxes, which in a three-limb core returns through air,
% tank and clearances: lm0 of a fraction of a pu). lm0 = lm reproduces a
% bank of three single-phase units or a five-limb core. Core losses are a
% linear resistance Rfe per limb on the primary coil voltage. The delta
% gives a path to the zero-sequence current: with a single-phase load a-n
% the load current is balanced by a current circulating in the delta, the
% primary line currents carry it in two lines only and the secondary
% neutral does not shift (compare with transformer_Yyn).
%
% Per-unit parameters on the rated three-phase power Sr and the rated
% line-to-line voltages V1, V2, with the star-equivalent base impedances
% Zb1 = V1^2/Sr and Zb2 = V2^2/Sr: a delta coil carries the line current
% divided by sqrt(3) at the line voltage, so its base is 3*Zb1 (the same pu
% value of resistance, leakage or magnetizing inductance gives the same
% line-side behaviour whatever the connection). From the nameplate:
% l1 + l2 = ucc/100 (short-circuit voltage), r1 + r2 = copper losses / Sr,
% lm = rated current / magnetizing line current, rfe = Sr / iron losses.
% The coil turns ratio follows from the rated voltages:
% n21 = (V2/sqrt(3))/V1.
%
% Positive current is taken into A, B, C and out of a, b, c (towards the
% load); i2a + i2b + i2c returns through n. The outputs psi_a, psi_b, psi_c
% are the flux linkages of the primary coils (V*s). Linear magnetics: no
% saturation, no hysteresis, no winding capacitances, no thermal port.

nodes
    A = foundation.electrical.electrical; % A:left
    B = foundation.electrical.electrical; % B:left
    C = foundation.electrical.electrical; % C:left
    a = foundation.electrical.electrical; % a:right
    b = foundation.electrical.electrical; % b:right
    c = foundation.electrical.electrical; % c:right
    n = foundation.electrical.electrical; % n:right
end

outputs
    psi_a = {0, 'V*s'};  % psi_a:right
    psi_b = {0, 'V*s'};  % psi_b:right
    psi_c = {0, 'V*s'};  % psi_c:right
end

parameters
    Sr  = {1e6,   'V*A'};   % Rated apparent power (three-phase)
    V1  = {690,   'V'  };   % Primary rated line-to-line voltage (rms)
    V2  = {690,   'V'  };   % Secondary rated line-to-line voltage (rms)
    fr  = {50,    'Hz' };   % Rated frequency
    clock_number = {11, '1'};   % Vector group clock number (1, 5, 7 or 11)
    r1  = {0.005, '1'  };   % Primary winding resistance (pu)
    l1  = {0.025, '1'  };   % Primary leakage inductance (pu)
    r2  = {0.005, '1'  };   % Secondary winding resistance (pu)
    l2  = {0.025, '1'  };   % Secondary leakage inductance (pu)
    lm  = {100,   '1'  };   % Positive-sequence magnetizing inductance (pu)
    lm0 = {0.5,   '1'  };   % Zero-sequence magnetizing inductance (pu)
    rfe = {500,   '1'  };   % Core-loss resistance per limb (pu)
end

parameters(Access=private)
    wb  = {2*pi,'rad'}*fr;    % rated angular frequency
    Zb1 = 3*V1^2/Sr;          % base impedance of a primary coil: delta, 3 x the star equivalent V1^2/Sr
    Zb2 = V2^2/Sr;            % base impedance of a secondary coil: star
    n21 = V2/(sqrt(3)*V1);    % coil turns ratio N2/N1: secondary phase voltage over primary line voltage
    R1  = r1*Zb1;             % resistance of one primary coil
    L1  = l1*Zb1/wb;          % leakage inductance of one primary coil
    R2  = r2*Zb2;             % resistance of one secondary coil
    L2  = l2*Zb2/wb;          % leakage inductance of one secondary coil
    Lm  = lm*Zb1/wb;          % positive-sequence magnetizing inductance, primary coil referred
    Lm0 = lm0*Zb1/wb;         % zero-sequence magnetizing inductance, primary coil referred
    Lc  = (Lm - Lm0)/3;       % limb-to-limb coupling term of the magnetizing inductance matrix
    Rfe = rfe*Zb1;            % core-loss resistance per limb, primary coil referred
end

variables
    iAB = {0, 'A'};  % current A -> B in the primary coil of limb a
    iBC = {0, 'A'};  % current B -> C in the primary coil of limb b
    iCA = {0, 'A'};  % current C -> A in the primary coil of limb c
    i2a = {0, 'A'};  % secondary current out of a (returns through n)
    i2b = {0, 'A'};  % secondary current out of b
    i2c = {0, 'A'};  % secondary current out of c
end

variables(Access=private)
    psia = {0, 'V*s'};  % flux linkage of the primary coil of limb a
    psib = {0, 'V*s'};  % flux linkage of the primary coil of limb b
    psic = {0, 'V*s'};  % flux linkage of the primary coil of limb c
    uma  = {0, 'V'};    % limb voltage dpsi_a/dt, induced in the primary coil of limb a
    umb  = {0, 'V'};    % limb voltage of limb b
    umc  = {0, 'V'};    % limb voltage of limb c
    ima  = {0, 'A'};    % magnetizing current of limb a, primary coil referred
    imb  = {0, 'A'};    % magnetizing current of limb b
    imc  = {0, 'A'};    % magnetizing current of limb c
    e2a  = {0, 'V'};    % emf of the secondary coil of phase a, positive at a
    e2b  = {0, 'V'};    % emf of the secondary coil of phase b
    e2c  = {0, 'V'};    % emf of the secondary coil of phase c
    f2a  = {0, 'A'};    % mmf of the secondary currents on limb a, primary turns, demagnetizing
    f2b  = {0, 'A'};    % mmf of the secondary currents on limb b
    f2c  = {0, 'A'};    % mmf of the secondary currents on limb c
end

branches
    iAB : A.i -> B.i;
    iBC : B.i -> C.i;
    iCA : C.i -> A.i;
    i2a : n.i -> a.i;
    i2b : n.i -> b.i;
    i2c : n.i -> c.i;
end

equations
    assert(Sr  > 0, 'Rated power must be positive')
    assert(V1  > 0 && V2 > 0, 'Rated voltages must be positive')
    assert(fr  > 0, 'Rated frequency must be positive')
    assert(r1 >= 0 && r2 >= 0, 'Winding resistances must be non-negative')
    assert(l1 >= 0 && l2 >= 0, 'Leakage inductances must be non-negative')
    assert(lm  > 0 && lm0 > 0, 'Magnetizing inductances must be positive')
    assert(rfe > 0, 'Core-loss resistance must be positive')
    assert(clock_number == 1 || clock_number == 5 || clock_number == 7 || clock_number == 11, ...
        'clock_number must be 1, 5, 7 or 11')

    % Limb voltages: the voltage induced in the primary coil of each limb by
    % its flux linkage. These are the only equations with der(psi): Simscape
    % counts every equation that contains der() as a differential equation
    % and requires as many of them as differentiated variables (9 here:
    % three fluxes, three primary and three secondary coil currents), so
    % the derivative of each flux is written once and the limb voltage is
    % used algebraically everywhere else.
    uma == der(psia);
    umb == der(psib);
    umc == der(psic);

    % Primary coils, delta: the coil of limb a is across A-B, of limb b
    % across B-C, of limb c across C-A. Terminal voltage = resistive and
    % leakage drop plus the limb voltage.
    A.v - B.v == R1*iAB + L1*der(iAB) + uma;
    B.v - C.v == R1*iBC + L1*der(iBC) + umb;
    C.v - A.v == R1*iCA + L1*der(iCA) + umc;

    % Secondary coils, star: emf minus the drop of the current delivered to
    % the load (generator convention).
    a.v - n.v == e2a - R2*i2a - L2*der(i2a);
    b.v - n.v == e2b - R2*i2b - L2*der(i2b);
    c.v - n.v == e2c - R2*i2c - L2*der(i2c);

    % Vector group: limb and winding sense of each secondary coil. The emf
    % of the coil of phase x on limb k with sense s is s*n21*um_k and its
    % mmf on that limb, in primary turns, is -s*n21*i2x (f2k = s*n21*i2x is
    % subtracted in the mmf balance below).
    if clock_number == 11
        % coil a on limb a (A-B), b on b (B-C), c on c (C-A), same sense
        e2a == n21*uma;
        e2b == n21*umb;
        e2c == n21*umc;
        f2a == n21*i2a;
        f2b == n21*i2b;
        f2c == n21*i2c;
    elseif clock_number == 5
        % same limbs as Dyn11, reversed sense: 180 degrees from Dyn11
        e2a == -n21*uma;
        e2b == -n21*umb;
        e2c == -n21*umc;
        f2a == -n21*i2a;
        f2b == -n21*i2b;
        f2c == -n21*i2c;
    elseif clock_number == 1
        % coil a on limb c (C-A, reversed: A-C), b on limb a (B-A), c on limb b (C-B)
        e2a == -n21*umc;
        e2b == -n21*uma;
        e2c == -n21*umb;
        f2c == -n21*i2a;
        f2a == -n21*i2b;
        f2b == -n21*i2c;
    else
        % clock_number == 7: same limbs as Dyn1, reversed sense: 180 degrees from Dyn1
        e2a == n21*umc;
        e2b == n21*uma;
        e2c == n21*umb;
        f2c == n21*i2a;
        f2a == n21*i2b;
        f2b == n21*i2c;
    end

    % Magneto-motive force balance of each limb, referred to the primary
    % coil; the core-loss current um/Rfe is subtracted from the net mmf.
    ima == iAB - f2a - uma/Rfe;
    imb == iBC - f2b - umb/Rfe;
    imc == iCA - f2c - umc/Rfe;

    % Magnetic circuit of the three-limb core: Lm for the positive and the
    % negative sequence of the magnetizing currents, Lm0 for the zero sequence.
    psia == Lm*ima - Lc*(ima + imb + imc);
    psib == Lm*imb - Lc*(ima + imb + imc);
    psic == Lm*imc - Lc*(ima + imb + imc);

    psi_a == psia;
    psi_b == psib;
    psi_c == psic;
end

annotations
    UILayout = [
        UIGroup('Ratings', Sr, V1, V2, fr)
        UIGroup('Vector group', clock_number)
        UIGroup('Impedances', r1, l1, r2, l2, lm, lm0, rfe)];
end

end
