component timed_switch
% Timed opening switch (Sw300) : 1.0
% Closed (Ron) until t_open, then the resistance rises exponentially from
% Ron to Roff in t_sw, as in the customer model (300 ns). The voltage is
% limited to Vcl (arc / protective clamp): v = Vcl*tanh(R*i/Vcl).
% Vcl must exceed the voltage the open switch has to hold afterwards.

nodes
    p = foundation.electrical.electrical; % +:left
    n = foundation.electrical.electrical; % -:right
end

parameters
    Ron    = {1e-3,   'Ohm'}; % On resistance, Ron
    Roff   = {1e6,    'Ohm'}; % Off resistance, Roff
    t_open = {1.2e-3, 's'  }; % Opening time, t_open
    t_sw   = {300e-9, 's'  }; % Switching time, t_sw
    Vcl    = {20e3,   'V'  }; % Clamp voltage, Vcl
end

variables
    i = {0, 'A'}; % Current
    v = {0, 'V'}; % Voltage
end

branches
    i : p.i -> n.i;
end

intermediates
    x  = (time - t_open)/t_sw;
    xs = if x < 0, 0 elseif x > 1, 1 else x end;
    R  = Ron*exp(log(Roff/Ron)*xs);
end

equations
    v == p.v - n.v;
    v == Vcl*tanh(R*i/Vcl);
end
end
