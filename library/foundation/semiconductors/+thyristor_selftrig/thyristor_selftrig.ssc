component thyristor_selftrig
% Thyristor with passive self-triggering gate network (functional)
%
% Functional model of a crowbar thyristor equipped with the floating
% anode-to-gate trigger network of "crowbar_thyristor_selftrigger" Rev. 00:
%
%     A ---|>|--- N ---+--------+--------+
%          D1         |        |        |
%                    C_g      R_C      BOD (V_st)
%                     |        |        |
%                     |        |       R_s
%                     +--------+--------+--- R_gs --- G
%                                                     |
%                                              R_GK  ||  D_GK
%                                                     |
%                                                     K
%
% Main switch: two-state event latch (off / on), PWL on-state
%   v = Vt0 + rT*i, off-state conductance Goff in both polarities.
% Turn-on sources (priority order, reported on output M):
%   1  gate network      junction current i_j >= Igt while v > 0
%   2  external gate     PS input G > Vgt while v > 0
%   3  intrinsic dv/dt   dv/dt > dvdt_crit while v > Vmin  (should never win)
%   4  forward breakover v > Vbo                           (should never win)
% Turn-off: i < Ih after the current has once exceeded Il (latched).
%
% Gate network (explicit, functional):
%   D1 on/off by sign of (v - vC); network current i_d1 flows A -> gate.
%   Cg*der(vC) = i_d1 - vC/Rc - i_st,   i_st = (vC - Vst)/Rs for vC > Vst.
%   Gate-cathode: vgk = Vgt*tanh(i_d1*Rgk/Vgt) (smooth clamp),
%   junction current i_j = i_d1 - vgk/Rgk.  Firing threshold is therefore
%   i_d1 = Igt + Vgt/Rgk, as in eq. (12) of the note.
% dv/dt is estimated with a first-order filter of time constant tau_f
% (no der() in event conditions).
%
% Not modelled (functional): turn-on delay and plasma spreading, di/dt
% limits, reverse recovery, tq. Use thyristor_rr for recovery studies.
%
% Ports: A (left), K (right), G external gate command in V (bottom,
% connect a PS Constant 0 if unused), M state/fire-mode code (top).
%
% Defaults: Hitachi Energy 5STP 26N6500 and the network values of the note.

  nodes
    a = foundation.electrical.electrical; % A:left
    k = foundation.electrical.electrical; % K:right
  end

  % G: external gate command (compared with Vgt)
  inputs
    G = {0, 'V'}; % G:bottom
  end
   
  % M: 0 off, 1 gate network, 2 ext. gate, 3 dv/dt, 4 breakover
  outputs
    M = {0, '1'}; % M:top  
  end

  parameters
    % --- on-state / blocking ---
    Vt0   = {1.12,    'V'    }; % Threshold voltage V_T0
    rT    = {0.29e-3, 'Ohm'  }; % Slope resistance r_T
    Goff  = {1e-6,    '1/Ohm'}; % Off-state conductance (both polarities)
    Il    = {2,       'A'    }; % Latching current I_L
    Ih    = {1,       'A'    }; % Holding current I_H
    % --- gate ---
    Igt   = {0.4,     'A'    }; % Gate trigger current I_GT
    Vgt   = {3,       'V'    }; % Gate trigger voltage V_GT
    Rgk   = {10,      'Ohm'  }; % Gate-cathode resistor R_GK
    % --- self-trigger network ---
    Cg    = {4.7e-9,  'F'    }; % Coupling capacitor C_g
    Rc    = {22e3,    'Ohm'  }; % Reset resistor R_C
    Rs    = {200,     'Ohm'  }; % Static path series resistor R_s
    Vst   = {450,     'V'    }; % Static path threshold V_st (BOD / TVS stack)
    Rser  = {11,      'Ohm'  }; % Series resistance in the loop (D1 on-state + R_gs)
    Gd1off= {1e-9,    '1/Ohm'}; % D1 off-state conductance
    % --- intrinsic self-firing (observation only) ---
    dvdt_crit = {1e9, 'V/s'  }; % Intrinsic critical dv/dt
    Vmin  = {50,      'V'    }; % Minimum forward voltage for intrinsic dv/dt firing
    Vbo   = {7800,    'V'    }; % Forward breakover voltage V_BO
    tau_f = {50e-9,   's'    }; % dv/dt sensing time constant
  end

  variables
    it = {0, 'A'};   % Terminal current A->K (device + network)
    i  = {0, 'A'};   % Main device current
    v  = {0, 'V'};   % Anode-cathode voltage
    vC = {0, 'V'};   % Coupling capacitor voltage (node N to gate side)
    vf = {0, 'V'};   % Filtered v for dv/dt estimate
  end

  variables (Event = true)
    on        = 0;   % 1 = conducting
    latched   = 0;   % 1 = current has exceeded Il since turn-on
    fire_mode = 0;   % turn-on source code (see M)
  end

  intermediates (ExternalAccess = observe)
    % D1 current = current delivered by the network to the gate node
    i_d1 = if (v - vC) > 0, (v - vC)/Rser else (v - vC)*Gd1off end;
    % static path (BOD / TVS stack) current, shunts Cg above Vst
    i_st = if (vC - Vst) > 0, (vC - Vst)/Rs else {0, 'A'} end;
    % gate-cathode voltage (smooth clamp at Vgt) and junction current
    vgk  = Vgt*tanh(i_d1*Rgk/Vgt);
    i_j  = i_d1 - vgk/Rgk;
    % estimated dv/dt
    dvdt = (v - vf)/tau_f;
  end

  branches
    it : a.i -> k.i;
  end

  equations
    v  == a.v - k.v;
    it == i + i_d1;
    Cg*der(vC)    == i_d1 - vC/Rc - i_st;
    tau_f*der(vf) == v - vf;
    M  == fire_mode;
    if on > 0.5
      v == Vt0 + rT*i;
    else
      i == v*Goff;
    end
  end

  equations (Initial = true)
    vC == 0.5*(v + abs(v));   % = max(v,0): no spurious pulse at t = 0
    vf == v;
  end

  events
    when edge((i_j >= Igt) && (v > 0) && (on < 0.5))
      on = 1; latched = 0; fire_mode = 1;      % gate network
    elsewhen edge((G > Vgt) && (v > 0) && (on < 0.5))
      on = 1; latched = 0; fire_mode = 2;      % external gate command
    elsewhen edge((dvdt > dvdt_crit) && (v > Vmin) && (on < 0.5))
      on = 1; latched = 0; fire_mode = 3;      % intrinsic dv/dt firing
    elsewhen edge((v > Vbo) && (on < 0.5))
      on = 1; latched = 0; fire_mode = 4;      % forward breakover
    elsewhen edge((i > Il) && (on > 0.5) && (latched < 0.5))
      latched = 1;                             % current latched
    elsewhen edge((i < Ih) && (latched > 0.5) && (on > 0.5))
      on = 0; latched = 0; fire_mode = 0;      % natural turn-off below Ih
    end
  end

  annotations
    a : Side = left;
    k : Side = right;
    G : Side = bottom;
    M : Side = top;
    UILayout = [UIGroup("On-state and blocking", Vt0, rT, Goff, Il, Ih)
                UIGroup("Gate", Igt, Vgt, Rgk)
                UIGroup("Self-trigger network", Cg, Rc, Rs, Vst, Rser, Gd1off)
                UIGroup("Intrinsic self-firing", dvdt_crit, Vmin, Vbo, tau_f)];
  end

end
